<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Lumen.UI.ViewModels"
             xmlns:nav="using:Lumen.UI.Navigation"
             mc:Ignorable="d"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             x:Class="Lumen.UI.Views.ShellView"
             x:DataType="vm:ShellViewModel"
             x:CompileBindings="True">

  <Grid RowDefinitions="Auto,*">

    <!-- Mandatory independence disclaimer, always visible. -->
    <Border Grid.Row="0" Background="#141B2A" Padding="16,8" BorderBrush="#232C40" BorderThickness="0,0,0,1">
      <TextBlock Text="{Binding Disclaimer}" TextWrapping="Wrap" FontSize="11" Foreground="#8595B2" />
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="230,*">

      <!-- Navigation pane -->
      <Border Grid.Column="0" Background="#0F1420">
        <DockPanel Margin="12">
          <StackPanel DockPanel.Dock="Top" Margin="6,10,6,18" Spacing="2">
            <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="Bold" Foreground="#EAF0FA" />
            <TextBlock Text="{Binding VersionLabel}" FontSize="11" Foreground="#5E6D89" />
          </StackPanel>
          <ListBox ItemsSource="{Binding Entries}"
                   SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                   Background="Transparent"
                   BorderThickness="0">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="nav:NavigationEntry">
                <StackPanel Orientation="Horizontal" Spacing="12" Margin="2">
                  <TextBlock Text="{Binding Glyph}" FontSize="15" Width="20" />
                  <TextBlock Text="{Binding Title}" FontSize="13" VerticalAlignment="Center" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <!-- Active page -->
      <ScrollViewer Grid.Column="1" Background="#0B0F17">
        <ContentControl Margin="28" Content="{Binding CurrentPage}" />
      </ScrollViewer>
    </Grid>
  </Grid>
</UserControl>
