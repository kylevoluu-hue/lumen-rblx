<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pages="using:Lumen.UI.ViewModels.Pages"
             x:Class="Lumen.UI.Views.Pages.InstallationsView"
             x:DataType="pages:InstallationsViewModel"
             x:CompileBindings="True">

  <StackPanel Spacing="18" MaxWidth="720" HorizontalAlignment="Left" Classes="pageRoot">
    <Grid ColumnDefinitions="*,Auto">
      <StackPanel Grid.Column="0" Spacing="6">
        <TextBlock Text="{Binding Title}" Classes="h1" />
        <TextBlock Text="{Binding Description}" Classes="subtitle" TextWrapping="Wrap" />
      </StackPanel>
      <Button Grid.Column="1" Classes="subtle" Content="Refresh" Command="{Binding RefreshCommand}" VerticalAlignment="Center" />
    </Grid>

    <Border Classes="card">
      <StackPanel Spacing="8">
        <TextBlock Classes="label" Text="ROBLOX PLAYER" />
        <TextBlock Text="{Binding PlayerStatus}" Classes="value" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Classes="label" Text="VERSION" />
          <TextBlock Text="{Binding PlayerVersion}" Classes="caption" />
        </StackPanel>
        <TextBlock Text="{Binding PlayerPath}" Classes="caption" TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <Border Classes="card">
      <StackPanel Spacing="8">
        <TextBlock Classes="label" Text="ROBLOX STUDIO" />
        <TextBlock Text="{Binding StudioStatus}" Classes="value" />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
