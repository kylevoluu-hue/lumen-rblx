<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pages="using:Lumen.UI.ViewModels.Pages"
             x:Class="Lumen.UI.Views.Pages.PlaceholderView"
             x:DataType="pages:PlaceholderPageViewModel"
             x:CompileBindings="True">

  <StackPanel Spacing="16" MaxWidth="640" HorizontalAlignment="Left">
    <StackPanel Spacing="4">
      <TextBlock Text="{Binding Title}" FontSize="30" FontWeight="Bold" Foreground="#EAF0FA" />
      <TextBlock Text="{Binding Description}" FontSize="14" Foreground="#8595B2" TextWrapping="Wrap" />
    </StackPanel>

    <Border Background="#141B2A" CornerRadius="10" Padding="16" BorderBrush="#232C40" BorderThickness="1">
      <StackPanel Spacing="6">
        <TextBlock Text="Roadmap" Classes="label" />
        <TextBlock Text="{Binding RoadmapNote}" TextWrapping="Wrap" FontSize="13" Foreground="#C3CEE2" />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
