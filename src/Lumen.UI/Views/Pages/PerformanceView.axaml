<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pages="using:Lumen.UI.ViewModels.Pages"
             x:Class="Lumen.UI.Views.Pages.PerformanceView"
             x:DataType="pages:PerformanceViewModel"
             x:CompileBindings="True">

  <StackPanel Spacing="18" MaxWidth="680" HorizontalAlignment="Left" Classes="pageRoot">
    <StackPanel Spacing="6">
      <TextBlock Text="{Binding Title}" Classes="h1" />
      <TextBlock Text="{Binding Description}" Classes="subtitle" TextWrapping="Wrap" />
    </StackPanel>

    <Border Classes="card">
      <StackPanel Spacing="14">
        <TextBlock Classes="label" Text="FRAME-RATE CAP" />
        <StackPanel Orientation="Horizontal" Spacing="10">
          <ComboBox ItemsSource="{Binding FpsOptions}" SelectedItem="{Binding SelectedFps, Mode=TwoWay}" MinWidth="140" />
          <Button Classes="accent" Content="Apply" Command="{Binding ApplyFpsCommand}" />
        </StackPanel>
        <TextBlock Text="{Binding StatusMessage}" Classes="caption" TextWrapping="Wrap" />
        <TextBlock Classes="caption" TextWrapping="Wrap"
                   Text="Higher caps only help if your hardware can render more frames. A cap above your monitor's refresh rate mainly benefits input latency." />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
