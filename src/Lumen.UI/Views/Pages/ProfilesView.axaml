<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pages="using:Lumen.UI.ViewModels.Pages"
             xmlns:models="using:Lumen.Core.Models"
             x:Class="Lumen.UI.Views.Pages.ProfilesView"
             x:DataType="pages:ProfilesViewModel"
             x:CompileBindings="True">

  <StackPanel Spacing="18" MaxWidth="680" HorizontalAlignment="Left" Classes="pageRoot">
    <StackPanel Spacing="6">
      <TextBlock Text="{Binding Title}" Classes="h1" />
      <TextBlock Text="{Binding Description}" Classes="subtitle" TextWrapping="Wrap" />
    </StackPanel>

    <Border Classes="card">
      <StackPanel Spacing="12">
        <ListBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile, Mode=TwoWay}"
                 Background="Transparent" BorderThickness="0" MaxHeight="280">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="models:LumenProfile">
              <StackPanel Orientation="Horizontal" Spacing="10" Margin="2">
                <TextBlock Text="{Binding Name}" FontSize="14" VerticalAlignment="Center"
                           Foreground="{DynamicResource LumenTextBrush}" />
                <Border Background="{DynamicResource LumenAccentSoftBrush}" CornerRadius="5" Padding="6,1"
                        IsVisible="{Binding IsDefault}" VerticalAlignment="Center">
                  <TextBlock Text="DEFAULT" FontSize="9" Foreground="{DynamicResource LumenAccentBrush}" />
                </Border>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBox Watermark="New profile name" Text="{Binding NewName, Mode=TwoWay}" Width="220" />
          <Button Classes="accent" Content="Create" Command="{Binding CreateCommand}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Classes="subtle" Content="Set as default"
                  Command="{Binding SetDefaultCommand}" CommandParameter="{Binding SelectedProfile}" />
          <Button Classes="subtle" Content="Delete"
                  Command="{Binding DeleteCommand}" CommandParameter="{Binding SelectedProfile}" />
        </StackPanel>
        <TextBlock Text="{Binding StatusMessage}" Classes="caption" TextWrapping="Wrap" />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
