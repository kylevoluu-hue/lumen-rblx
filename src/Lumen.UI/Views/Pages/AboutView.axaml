<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pages="using:Lumen.UI.ViewModels.Pages"
             x:Class="Lumen.UI.Views.Pages.AboutView"
             x:DataType="pages:AboutViewModel"
             x:CompileBindings="True">

  <StackPanel Spacing="16" MaxWidth="640" HorizontalAlignment="Left">
    <TextBlock Text="Lumen" FontSize="34" FontWeight="Bold" Foreground="#EAF0FA" />
    <TextBlock Text="{Binding Description}" FontSize="15" Foreground="#8595B2" />
    <StackPanel Orientation="Horizontal" Spacing="8">
      <TextBlock Classes="label" Text="VERSION" VerticalAlignment="Center" />
      <TextBlock Text="{Binding Version}" FontSize="13" Foreground="#C3CEE2" />
    </StackPanel>

    <Border Classes="card" MinWidth="0">
      <TextBlock Text="{Binding AboutText}" TextWrapping="Wrap" FontSize="13" Foreground="#C3CEE2" LineHeight="20" />
    </Border>

    <Border Background="#141B2A" CornerRadius="10" Padding="16" BorderBrush="#232C40" BorderThickness="1">
      <TextBlock Text="{Binding Disclaimer}" TextWrapping="Wrap" FontSize="12" Foreground="#8595B2" />
    </Border>
  </StackPanel>
</UserControl>
