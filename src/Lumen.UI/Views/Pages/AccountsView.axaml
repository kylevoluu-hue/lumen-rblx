<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pages="using:Lumen.UI.ViewModels.Pages"
             xmlns:models="using:Lumen.Core.Models"
             x:Class="Lumen.UI.Views.Pages.AccountsView"
             x:DataType="pages:AccountsViewModel"
             x:CompileBindings="True">

  <StackPanel Spacing="18" Classes="pageRoot">
    <StackPanel Spacing="6">
      <TextBlock Text="{Binding Title}" Classes="h1" />
      <TextBlock Text="{Binding Description}" Classes="subtitle" TextWrapping="Wrap" />
    </StackPanel>

    <!-- Sign in (official, in the browser) -->
    <Border Classes="card">
      <StackPanel Spacing="12">
        <TextBlock Classes="label" Text="SIGN IN" />
        <TextBlock TextWrapping="Wrap" Classes="body"
                   Text="Sign in on Roblox's official login page in your browser. Lumen never sees your password or cookies — after you sign in, launches use that Roblox session." />
        <Button Classes="accent" HorizontalAlignment="Left"
                Content="Sign in with Roblox" Command="{Binding SignInCommand}" />
      </StackPanel>
    </Border>

    <!-- Link a Roblox account by public username -->
    <Border Classes="card">
      <StackPanel Spacing="12">
        <TextBlock Classes="label" Text="LINK ROBLOX ACCOUNT" />
        <TextBlock Classes="body" TextWrapping="Wrap"
                   Text="Enter your Roblox username to show your public profile and friends on the Social page. Only public information is fetched — never your password or cookies." />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBox Watermark="Roblox username" Text="{Binding LinkUsername, Mode=TwoWay}" Width="240" />
          <Button Classes="accent" Content="Link" Command="{Binding LinkCommand}" />
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- Honest note about in-app account switching -->
    <Border Background="#2A2015" BorderBrush="#5A4522" BorderThickness="1" CornerRadius="10" Padding="16">
      <StackPanel Spacing="6">
        <TextBlock Text="About account switching" FontWeight="SemiBold" Foreground="#E9C77E" />
        <TextBlock Text="{Binding AuthenticationExplanation}" TextWrapping="Wrap" FontSize="12" Foreground="#C9B48A" />
      </StackPanel>
    </Border>

    <Border Classes="card">
      <StackPanel Spacing="12">
        <TextBlock Classes="label" Text="LOCAL ACCOUNT LABELS" />
        <ListBox ItemsSource="{Binding Accounts}"
                 SelectedItem="{Binding SelectedAccount, Mode=TwoWay}"
                 Background="Transparent" BorderThickness="0" MaxHeight="240">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="models:Account">
              <StackPanel Spacing="2" Margin="2">
                <TextBlock Text="{Binding DisplayLabel}" FontSize="14" Foreground="{DynamicResource LumenTextBrush}" />
                <TextBlock Text="{Binding Username}" FontSize="11" Foreground="{DynamicResource LumenTextMutedBrush}" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBox Watermark="New account nickname" Text="{Binding NewNickname, Mode=TwoWay}" Width="240" />
          <Button Classes="subtle" Content="Add label" Command="{Binding AddCommand}" />
          <Button Classes="subtle" Content="Remove selected"
                  Command="{Binding RemoveCommand}" CommandParameter="{Binding SelectedAccount}" />
        </StackPanel>
        <TextBlock Text="{Binding StatusMessage}" Classes="caption" TextWrapping="Wrap" />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
