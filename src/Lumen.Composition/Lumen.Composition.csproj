<Project Sdk="Microsoft.NET.Sdk">

  <!--
    UI-agnostic composition: registers every Lumen service and shared view-model into a
    ServiceCollection. Both UI heads (Avalonia, WinUI 3) call AddLumenServices() and then add only
    their own IThemeApplier implementation, so the two front-ends share one identical service graph.
    This project references no UI framework.
  -->

  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Lumen.Core\Lumen.Core.csproj" />
    <ProjectReference Include="..\Lumen.Security\Lumen.Security.csproj" />
    <ProjectReference Include="..\Lumen.Storage\Lumen.Storage.csproj" />
    <ProjectReference Include="..\Lumen.Diagnostics\Lumen.Diagnostics.csproj" />
    <ProjectReference Include="..\Lumen.Roblox\Lumen.Roblox.csproj" />
    <ProjectReference Include="..\Lumen.Accounts\Lumen.Accounts.csproj" />
    <ProjectReference Include="..\Lumen.Mods\Lumen.Mods.csproj" />
    <ProjectReference Include="..\Lumen.Profiles\Lumen.Profiles.csproj" />
    <ProjectReference Include="..\Lumen.Launching\Lumen.Launching.csproj" />
    <ProjectReference Include="..\Lumen.Presentation\Lumen.Presentation.csproj" />
  </ItemGroup>

</Project>
